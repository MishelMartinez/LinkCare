{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corrección de una atención (v1)",
  "type": "object",
  "required": ["correctsEventId"],
  "properties": {
    "correctsEventId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "motivo": { "type": "string", "maxLength": 2000 },
    "datos": { "type": "object" }
  }
}
