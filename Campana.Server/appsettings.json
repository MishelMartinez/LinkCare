{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Campana": {
    "Storage": "FileSystem",
    "DataRoot": "./data",
    "Port": 8443,
    "MaxAttachmentBytes": 10485760,
    "AllowedAttachmentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png"
    ],
    "MinFreeDiskBytes": 2147483648,
    "ConsistencyIntervalMinutes": 5,
    "Jwt": {
      "Issuer": "campana",
      "Audience": "campana-clientes",
      "ExpiresHours": 8
    },
    "Tls": {
      "Enabled": true
    },
    "Training": {
      "AudioRoot": null,
      "SlidesRoot": null
    },
    "FileShare": {
      "Root": null
    }
  }
}